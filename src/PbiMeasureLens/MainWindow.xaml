<Window x:Class="PbiMeasureLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:PbiMeasureLens.Models"
        Title="PBI Measure Lens" Height="760" Width="1260"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open .pbix…" Click="OpenPbix_Click" />
                    <TextBlock x:Name="PbixPathText" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="#444" Text="(no report loaded)" TextTrimming="CharacterEllipsis" MaxWidth="660" />
                    <TextBlock x:Name="PbixStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="#888" Text="" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add model folder…" Click="AddModelFolder_Click" />
                        <Button Content="Add model file…" Click="AddModelFile_Click" />
                        <Button Content="Clear all" Click="ClearModelFolders_Click" />
                        <TextBlock x:Name="ModelInfoText" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="#444" Text="No semantic-model folders configured." TextTrimming="CharacterEllipsis" MaxWidth="820" />
                    </StackPanel>
                    <ItemsControl x:Name="ModelChips" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E8F0FE" BorderBrush="#AAC4F0" BorderThickness="1"
                                        CornerRadius="3" Margin="0,0,4,4" Padding="5,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="#234" ToolTip="{Binding Path}" />
                                        <Button Content="✕" Tag="{Binding Path}" Click="RemoveModel_Click"
                                                Margin="5,0,0,0" Padding="3,0" FontSize="11"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="Remove this model" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Visuals -->
            <GroupBox Grid.Column="0" Header="Visuals">
                <DockPanel>
                    <CheckBox x:Name="HideSlicers" DockPanel.Dock="Top" Content="Hide slicers"
                              Margin="2,0,2,4" Checked="HideSlicers_Changed" Unchecked="HideSlicers_Changed" />
                <ListBox x:Name="VisualsList" SelectionChanged="VisualsList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:VisualInfo}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,6,2,2" Foreground="#2A6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEE" />

            <!-- Fields -->
            <GroupBox Grid.Column="2" Header="Fields">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copy table" Click="Copy_Click" />
                            <Button Content="Copy table + DAX" Click="CopyWithDax_Click" Margin="6,0,0,0" />
                            <Button Content="Export CSV…" Click="ExportCsv_Click" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="SearchBox" Width="170" VerticalAlignment="Center"
                                     TextChanged="Filter_Changed" />
                            <CheckBox x:Name="WholeReport" Content="Whole report" VerticalAlignment="Center"
                                      Margin="10,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="FieldsGrid_SelectionChanged"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="45" />
                            <DataGridTextColumn Header="Visual" Binding="{Binding VisualLabel}" Width="45" />
                            <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="45" />
                            <DataGridTextColumn Header="Original name" Binding="{Binding OriginalName}" Width="*" />
                            <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="55" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#EEE" />

            <!-- Measure detail: DAX/deps + Footprint -->
            <GroupBox Grid.Column="4" Header="Measure detail">
                <DockPanel>
                    <!-- Selected field context: a distinct block that updates with the Fields grid selection -->
                    <Border DockPanel.Dock="Top" DataContext="{Binding SelectedItem, ElementName=FieldsGrid}"
                            Background="#EAF2FB" BorderBrush="#B8D2F0" BorderThickness="1"
                            CornerRadius="3" Padding="6" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="DataContext" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Page" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#555" Margin="0,1,10,1" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Page}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Table" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#555" Margin="0,1,10,1" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Table}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Visual" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#555" Margin="0,1,10,1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VisualLabel}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Original name" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#555" Margin="0,1,10,1" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OriginalName}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Display name" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#555" Margin="0,1,10,1" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                <TabControl>
                    <TabItem Header="DAX &amp; dependencies">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="80" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.4*" MinHeight="120" />
                            </Grid.RowDefinitions>
                            <RichTextBox x:Name="DaxBox" Grid.Row="0" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5" />
                            <TextBlock Grid.Row="1" Text="Dependency tree" FontWeight="Bold" Margin="2,6,2,2" Foreground="#666" />
                            <TreeView x:Name="DepTree" Grid.Row="2" SelectedItemChanged="DepTree_SelectedItemChanged">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type m:MeasureNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Display}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Column">
                                                            <Setter Property="Foreground" Value="#666" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Unresolved">
                                                            <Setter Property="Foreground" Value="#C00" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Cycle">
                                                            <Setter Property="Foreground" Value="#E07000" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Footprint (where-used)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0.7*" MinHeight="60" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FootprintSummary" Grid.Row="0" TextWrapping="Wrap" Margin="2,2,2,4"
                                       Text="Select a measure to see where it is used across the report." />
                            <TextBlock Grid.Row="1" Text="Displayed in these visuals:" FontWeight="Bold" Margin="2,4,2,2" Foreground="#666" />
                            <DataGrid x:Name="UsageGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="*" />
                                    <DataGridTextColumn Header="Visual" Binding="{Binding Visual}" Width="*" />
                                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="3" Text="Referenced by these measures:" FontWeight="Bold" Margin="2,8,2,2" Foreground="#666" />
                            <ListBox x:Name="RefByList" Grid.Row="4" />
                        </Grid>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
