<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PbiMeasureLens</AssemblyName>
    <RootNamespace>PbiMeasureLens</RootNamespace>
    <Version>0.1.0</Version>
    <Product>PBI Measure Lens</Product>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- Default platform for single-file self-contained publish; flags passed on the publish command. -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
